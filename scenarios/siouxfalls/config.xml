<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="Atlantis" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="network.xml" />
	</module>

	<module name="plans">
		<param name="inputPlansFile" value="population-1pct.xml" />
	</module>

	<!-- 1% population sample: scale network flow/storage to match. -->
	<!-- When regenerating at another sample rate, set both factors to that rate. -->
	<module name="qsim">
		<param name="flowCapacityFactor" value="0.01" />
		<param name="storageCapacityFactor" value="0.01" />
	</module>

	<module name="controller">
		<param name="outputDirectory" value="./output-siouxfalls-1pct" />
		<param name="lastIteration" value="10" />
	</module>

	<module name="scoring">
		<param name="lateArrival" value="-18" />
		<param name="performing" value="+6" />
		<parameterset type="activityParams" >
			<param name="activityType"            value="h" />
			<param name="typicalDuration" value="12:00:00" />
		</parameterset>
		<parameterset type="activityParams" >
			<param name="activityType"            value="w" />
			<param name="typicalDuration" value="08:00:00" />
			<param name="openingTime"     value="07:00:00" />
			<param name="closingTime"     value="18:00:00" />
		</parameterset>
		<!-- Phase 4 hospital visits (unused until the quake redirector lands). -->
		<parameterset type="activityParams" >
			<param name="activityType"            value="hospital" />
			<param name="typicalDuration" value="01:00:00" />
		</parameterset>
	</module>

	<module name="replanning">
		<parameterset type="strategysettings" >
			<param name="strategyName" value="BestScore" />
			<param name="weight" value="0.9" />
		</parameterset>
		<parameterset type="strategysettings" >
			<param name="strategyName" value="ReRoute" />
			<param name="weight" value="0.1" />
		</parameterset>
	</module>

</config>
